# Example environment variables for frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key is secret and should only be used on the server side.
# Do not add this key to client-side code or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=

# Add other env vars as needed (e.g., NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY)
